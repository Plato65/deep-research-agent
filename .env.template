# ============================================================================
# DEEP RESEARCH AGENT CONFIGURATION
# ============================================================================
# Copy this file to .env and configure for your setup
#
# Quick Start (3 options):
#
# OPTION A: Cloud-Only (Easiest)
#   MODEL_PROVIDER=gemini
#   GEMINI_API_KEY=your_key_here
#
# OPTION B: Local-Only (Privacy)
#   RESEARCH_MODE=privacy
#   MODEL_PROVIDER=lmstudio
#   → Load model in LM Studio on port 1234
#
# OPTION C: Hybrid (Best Quality - YOUR SETUP)
#   MODEL_PROVIDER=gemini (for basic stages)
#   USE_OLMO_CRITIC=true (LM Studio port 1234)
#   USE_DR_TULU_WRITER=true (LM Studio port 1235)
#
# See docs/CONFIGURATION_GUIDE.md for detailed explanation

# ============================================================================
# RESEARCH MODE (Drives Multiple Settings)
# ============================================================================
# Options: weekly | general | privacy
#
# weekly  = Recent news monitoring (<14 days), deduplication
# general = Comprehensive research, all time periods (DEFAULT)
# privacy = Local-only, no external APIs, LM Studio/Ollama required
#
RESEARCH_MODE=general

# ============================================================================
# PRIMARY MODEL PROVIDER
# ============================================================================
# Options: gemini | openai | ollama | lmstudio
#
# Used for: Planning, Searching, Synthesis (unless overridden below)
#
MODEL_PROVIDER=gemini

# ============================================================================
# API KEYS (Based on Provider)
# ============================================================================

# Gemini (Google AI)
# Get key: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI
# Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# LM Studio (Local - No API key needed)
# Download: https://lmstudio.ai
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL_NAME=local-model

# Ollama (Local - No API key needed)
# Download: https://ollama.ai
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# SEARCH API KEYS (Optional but Recommended)
# ============================================================================
# At least one search API improves quality significantly
# DuckDuckGo (free, no key) is used as fallback

# Serper (Google Search) - https://serper.dev
# Recommended for: News, general web search
# SERPER_API_KEY=your_serper_key_here

# Tavily (Research Search) - https://tavily.com
# Recommended for: Deep research, academic content
# TAVILY_API_KEY=your_tavily_key_here

# Brave Search - https://brave.com/search/api/
# Recommended for: Privacy-focused search
# BRAVE_API_KEY=your_brave_key_here

# ============================================================================
# STAGE-SPECIFIC MODELS (Advanced - Override Primary Provider)
# ============================================================================
# Use different models for different workflow stages
# Leave commented to use PRIMARY MODEL PROVIDER for all stages
#
# Workflow Stages:
#   1. Planning     → Generate research objectives and search queries
#   2. Searching    → Execute searches and generate additional queries
#   3. Synthesis    → Extract key findings from search results
#   4. Critique     → Evaluate research quality (optional self-correction)
#   5. Writing      → Generate final report with citations
#
# Recommended Setup for Mac Mini M4 64GB:
#   - Stages 1-3: Use Gemini/OpenAI (fast, cheap)
#   - Stage 4 (Critique): Use OLMo via LM Studio (enhanced reasoning)
#   - Stage 5 (Writing): Use DR Tulu via LM Studio (88.6% citation precision)

# Stage 1: Planning
# Override model for research planning stage
# Example: PLANNER_MODEL=gpt-4o (for better reasoning)
# PLANNER_MODEL=

# Stage 2: Searching
# Override model for search query generation
# Example: SEARCH_MODEL=gemini-2.5-flash (for speed)
# SEARCH_MODEL=

# Stage 3: Synthesis
# Override model for summarizing search results
# Example: SYNTHESIS_MODEL=gemini-2.5-flash (for cost efficiency)
# SYNTHESIS_MODEL=

# Stage 4: Critique (Use OLMo for Enhanced Reasoning)
# Enable OLMo 3 32B Think for quality evaluation
# Requires: LM Studio with Olmo-3-32B-Think loaded
USE_OLMO_CRITIC=false
OLMO_ENDPOINT=http://localhost:1234/v1
# OLMO_MODEL_NAME=local-model

# Stage 5: Writing (Use DR Tulu for Citation Accuracy)
# Enable DR Tulu-8B for report writing (fixes citation bugs)
# Requires: LM Studio with DR-Tulu-8B loaded
USE_DR_TULU_WRITER=false
DR_TULU_ENDPOINT=http://localhost:1235/v1
# DR_TULU_MODEL_NAME=local-model

# ============================================================================
# RECOMMENDED CONFIGURATIONS
# ============================================================================
#
# CONFIG 1: Quick Start (Cloud-Only)
#   MODEL_PROVIDER=gemini
#   GEMINI_API_KEY=your_key
#   → Fast setup, good quality, costs ~$0.10/report
#
# CONFIG 2: Privacy Mode (Local-Only)
#   RESEARCH_MODE=privacy
#   MODEL_PROVIDER=lmstudio
#   LMSTUDIO_BASE_URL=http://localhost:1234/v1
#   → Load one model in LM Studio (Qwen, Llama, etc.)
#   → No external APIs, fully private
#
# CONFIG 3: Hybrid Quality (YOUR RECOMMENDED SETUP)
#   MODEL_PROVIDER=gemini
#   GEMINI_API_KEY=your_key
#   USE_OLMO_CRITIC=true
#   OLMO_ENDPOINT=http://localhost:1234/v1
#   USE_DR_TULU_WRITER=true
#   DR_TULU_ENDPOINT=http://localhost:1235/v1
#   → LM Studio Instance 1: Olmo-3-32B-Think on port 1234
#   → LM Studio Instance 2: DR-Tulu-8B on port 1235
#   → Best quality: Enhanced critique + Citation fix
#   → Cost: ~$0.05/report (Gemini for basic stages)
#
# CONFIG 4: All-Local with Multiple Models
#   MODEL_PROVIDER=lmstudio
#   LMSTUDIO_BASE_URL=http://localhost:1234/v1
#   PLANNER_MODEL=local-model
#   USE_OLMO_CRITIC=true
#   OLMO_ENDPOINT=http://localhost:1236/v1
#   USE_DR_TULU_WRITER=true
#   DR_TULU_ENDPOINT=http://localhost:1237/v1
#   → Run 3 LM Studio instances on different ports
#   → Fully local, maximum quality
#   → Requires: 80GB+ RAM for all models simultaneously

# ============================================================================
# MODEL DEFAULTS (Use When No Stage-Specific Override)
# ============================================================================

# Default model for all stages (if not overridden)
# Examples: gemini-2.5-flash, gpt-4o-mini, qwen2.5:7b, local-model
# MODEL_NAME=gemini-2.5-flash

# Fast model for summarization and synthesis
# SUMMARIZATION_MODEL=gemini-2.5-flash

# ============================================================================
# SEARCH CONFIGURATION (Fine-Tuning)
# ============================================================================

# Number of search queries to generate (1-10, default: 5)
# MAX_SEARCH_QUERIES=5

# Results per search query (1-10, default: 5)
# MAX_SEARCH_RESULTS_PER_QUERY=5

# Maximum age of sources in days (0 = no filter, default: 365)
# MAX_SOURCE_AGE_DAYS=365

# ============================================================================
# REPORT CONFIGURATION (Fine-Tuning)
# ============================================================================

# Maximum sections in final report (default: 8)
# MAX_REPORT_SECTIONS=8

# Minimum words per section (default: 200)
# MIN_SECTION_WORDS=200

# Citation style: apa | mla | chicago | ieee (default: apa)
# CITATION_STYLE=apa

# ============================================================================
# QUALITY & CREDIBILITY (Fine-Tuning)
# ============================================================================

# Minimum credibility score to include sources (0-100, default: 40)
# MIN_CREDIBILITY_SCORE=40

# Enable deduplication (avoid repeating sources from previous reports)
# ENABLE_DEDUPLICATION=false

# ============================================================================
# RSS FEEDS (Early Signal Detection)
# ============================================================================

# Enable RSS feed ingestion (blogs, newsletters, arXiv)
# ENABLE_RSS_FEEDS=true

# Number of days back to fetch RSS items (default: 7)
# RSS_FEED_DAYS=7

# Priority filter: high | medium | low | null (all feeds)
# RSS_PRIORITY_FILTER=high

# ============================================================================
# ADVANCED SETTINGS (Rarely Changed)
# ============================================================================

# LLM temperature (0.0-1.0, default: 0.7)
# LLM_TEMPERATURE=0.7

# Synthesis temperature (0.0-1.0, default: 0.3)
# SYNTHESIS_TEMPERATURE=0.3

# Maximum retries for failed operations (default: 3)
# MAX_RETRIES=3

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# LOG_LEVEL=INFO

# Enable LangSmith tracing for debugging
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_PROJECT=deep-research-agent

# ============================================================================
# TROUBLESHOOTING
# ============================================================================
#
# Problem: "No API key found"
# Solution: Set GEMINI_API_KEY or OPENAI_API_KEY for your chosen provider
#
# Problem: "Cannot connect to LM Studio"
# Solution: 1) Open LM Studio
#           2) Load a model
#           3) Start server on port 1234
#           4) Verify: curl http://localhost:1234/v1/models
#
# Problem: "Citation bugs persist"
# Solution: Enable DR Tulu:
#           USE_DR_TULU_WRITER=true
#           DR_TULU_ENDPOINT=http://localhost:1235/v1
#
# Problem: "Out of memory with multiple LM Studio instances"
# Solution: Use hybrid config (Gemini for basic stages, LM Studio for critical stages)
#
# For more help: See docs/CONFIGURATION_GUIDE.md
