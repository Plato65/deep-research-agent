# Deep Research Agent Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# RESEARCH MODE SELECTION
# ============================================================================
# Choose operational mode: weekly | general | privacy
#
# WEEKLY MODE:  Recent news monitoring (<14 days), deduplication, fast updates
#               Best for: Weekly briefings, tracking recent developments
#               Search APIs: Serper (news) + Tavily (research) + Brave (fallback)
#
# GENERAL MODE: Comprehensive research, no date limits, all sources (DEFAULT)
#               Best for: Deep research on any topic, maximum coverage
#               Search APIs: All available (Serper, Tavily, Brave, DuckDuckGo)
#
# PRIVACY MODE: Fully local, no external APIs, no tracking
#               Best for: Sensitive research, air-gapped environments
#               Search APIs: DuckDuckGo only (no API keys required)
#               Models: Ollama or LM Studio (forces local models)
#
RESEARCH_MODE=general

# ============================================================================
# SEARCH API KEYS (Optional - mode-dependent)
# ============================================================================
# Serper (Google Search API) - https://serper.dev
# SERPER_API_KEY=your_serper_key_here

# Tavily (Research Search API) - https://tavily.com
# TAVILY_API_KEY=your_tavily_key_here

# Brave Search API - https://brave.com/search/api/
# BRAVE_API_KEY=your_brave_key_here

# Note: Weekly and General modes use these APIs when available
#       Privacy mode ignores these and uses only DuckDuckGo

# ============================================================================
# MODEL PROVIDER CONFIGURATION
# ============================================================================
# Choose one: ollama, gemini, openai, lmstudio
# Note: Privacy mode requires local models (ollama or lmstudio)
MODEL_PROVIDER=gemini

# ============================================================================
# OLLAMA CONFIGURATION (Local Models)
# ============================================================================
# Ollama base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Model name for Ollama (e.g., qwen2.5:7b, llama3.1:8b, mistral:7b)
# MODEL_NAME=qwen2.5:7b
# SUMMARIZATION_MODEL=qwen2.5:7b

# ============================================================================
# LM STUDIO CONFIGURATION (Local Models - OpenAI Compatible)
# ============================================================================
# LM Studio base URL (default: http://localhost:1234/v1)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Model name must match the model loaded in LM Studio
# LMSTUDIO_MODEL_NAME=local-model

# ============================================================================
# GOOGLE GEMINI CONFIGURATION (Cloud API)
# ============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# MODEL_NAME=gemini-2.5-flash
# SUMMARIZATION_MODEL=gemini-2.5-flash

# ============================================================================
# OPENAI CONFIGURATION (Cloud API)
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # Default, change for proxies
# MODEL_NAME=gpt-4o-mini
# SUMMARIZATION_MODEL=gpt-4o-mini

# ============================================================================
# AGENT-SPECIFIC MODEL CONFIGURATION (Optional Fine-Tuning)
# ============================================================================
# Override default models for specific agents. If not set, agents use MODEL_NAME
# or SUMMARIZATION_MODEL as appropriate.
#
# Example use case: Use fast model for planning/search, powerful model for writing
# PLANNER_MODEL=gemini-2.5-flash      # Fast model for planning
# SEARCH_MODEL=qwen2.5:7b             # Local model for search queries
# SYNTHESIS_MODEL=gemini-2.5-flash    # Fast model for summarization
# WRITING_MODEL=gpt-4o                # Powerful model for final report writing
#
# Example: All local with Qwen2.5 variants
# PLANNER_MODEL=qwen2.5:7b
# SEARCH_MODEL=qwen2.5:7b
# SYNTHESIS_MODEL=qwen2.5:7b
# WRITING_MODEL=qwen2.5:32b           # Larger model for better writing quality

# ============================================================================
# SPECIALIZED MODELS: DR TULU & OLMO (High-Precision Citations & Reasoning)
# ============================================================================
# DR Tulu-8B: First open deep research model with 88.6% citation precision
# OLMo 3 32B Think: Enhanced reasoning model with explicit thinking
#
# Benefits:
# - DR Tulu: Fixes citation mapping bugs, 1000x cheaper than GPT-4 ($0.002 vs $1.80)
# - OLMo: Improved quality evaluation with transparent reasoning
#
# Server Options:
# OPTION A: VLLM (requires Python 3.10+, CUDA/Metal support)
#   - Best for Linux/Windows with NVIDIA GPU
#   - pip install vllm
#   - Start: ./scripts/serve_all_models.sh
#
# OPTION B: LM Studio (recommended for macOS)
#   - Best for Mac Mini M4, easier setup
#   - Download from: https://lmstudio.ai
#   - See docs/SEQUENTIAL_WORKFLOW.md for using both models

# ┌─────────────────────────────────────────────────────────────┐
# │ CONFIGURATION OPTIONS (Choose One)                          │
# └─────────────────────────────────────────────────────────────┘
#
# OPTION 1: DR Tulu Only (Recommended - Fixes Critical Citation Bug)
#   USE_DR_TULU_WRITER=true
#   DR_TULU_ENDPOINT=http://localhost:1234/v1
#   USE_OLMO_CRITIC=false
#   → LM Studio: Load DR-Tulu-8B on port 1234
#   → Result: 88.6% citation precision (vs current 6.5/10)
#
# OPTION 2: Both Models (Best Quality - Requires 48GB RAM)
#   USE_DR_TULU_WRITER=true
#   DR_TULU_ENDPOINT=http://localhost:1235/v1
#   USE_OLMO_CRITIC=true
#   OLMO_ENDPOINT=http://localhost:1234/v1
#   → LM Studio Instance 1: Olmo-3-32B-Think on port 1234
#   → LM Studio Instance 2: DR-Tulu-8B on port 1235
#   → Result: Enhanced critique + Citation fix
#
# OPTION 3: OLMo Only (Enhanced Critique, Citation Bug Remains)
#   USE_DR_TULU_WRITER=false
#   USE_OLMO_CRITIC=true
#   OLMO_ENDPOINT=http://localhost:1234/v1
#   → LM Studio: Load Olmo-3-32B-Think on port 1234
#   → Result: Better evaluation, standard citations

# Default: Disabled (use standard models)
USE_DR_TULU_WRITER=false
USE_OLMO_CRITIC=false

# DR Tulu endpoint (change port if running multiple LM Studio instances)
DR_TULU_ENDPOINT=http://localhost:1234/v1

# DR Tulu model name (optional, usually auto-detects)
# Only set if you get connection errors with LM Studio
# DR_TULU_MODEL_NAME=local-model

# OLMo endpoint (change port if running multiple LM Studio instances)
OLMO_ENDPOINT=http://localhost:1234/v1

# OLMo model name (optional)
# OLMO_MODEL_NAME=local-model

# ============================================================================
# SEARCH CONFIGURATION
# ============================================================================
# Maximum number of search queries to generate (1-10, default: 5)
# Increased from 3 to 5 for better source diversity
MAX_SEARCH_QUERIES=5

# Maximum results per search query (1-10, default: 5)
# Increased from 3 to 5 to gather more diverse sources
MAX_SEARCH_RESULTS_PER_QUERY=5

# Maximum parallel search operations (1-10, default: 3)
MAX_PARALLEL_SEARCHES=3

# Enable time-bound searches for recent content (true/false, default: true)
# When enabled, adds date filters and "latest", "recent", "2024" to queries
ENABLE_TIME_BOUND_SEARCHES=true

# Time window for recency filter in days (default: 365)
# Only include sources from the last N days (0 = no filter)
MAX_SOURCE_AGE_DAYS=365

# Enable specialized source searches (true/false, default: true)
ENABLE_ARXIV_SEARCH=true
ENABLE_SSRN_SEARCH=true
ENABLE_HACKERNEWS_SEARCH=true
ENABLE_REDDIT_SEARCH=true

# Reddit API credentials (optional, for better rate limits)
# Get from: https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your_client_id
# REDDIT_CLIENT_SECRET=your_client_secret
# REDDIT_USER_AGENT=deep-research-agent/1.0

# ============================================================================
# CREDIBILITY & QUALITY CONFIGURATION
# ============================================================================
# Minimum credibility score to include sources (0-100, default: 40)
MIN_CREDIBILITY_SCORE=40

# Enable consulting firm report detection (true/false, default: true)
DETECT_CONSULTING_REPORTS=true

# Enable academic source prioritization (true/false, default: true)
PRIORITIZE_ACADEMIC_SOURCES=true

# Enable recency scoring - prioritize more recent sources (true/false, default: true)
# Recent sources get bonus points: +20 for <30 days, +18 for <3 months, +15 for <6 months, etc.
ENABLE_RECENCY_SCORING=true

# ============================================================================
# REPORT CONFIGURATION
# ============================================================================
# Maximum number of sections in the final report (1-15, default: 8)
MAX_REPORT_SECTIONS=8

# Minimum words per section (50-500, default: 200)
MIN_SECTION_WORDS=200

# Citation style: apa, mla, chicago, ieee (default: apa)
CITATION_STYLE=apa

# Enable multi-format export (true/false, default: true)
ENABLE_HTML_EXPORT=true
ENABLE_TXT_EXPORT=true

# ============================================================================
# RATE LIMITING & TIMEOUTS
# ============================================================================
# Web request timeout in seconds (5-60, default: 10)
WEB_REQUEST_TIMEOUT=10

# Search rate limit: minimum seconds between searches (1-10, default: 2)
SEARCH_RATE_LIMIT_SECONDS=2

# Content extraction timeout in seconds (5-30, default: 15)
CONTENT_EXTRACTION_TIMEOUT=15

# Maximum retries for failed operations (1-5, default: 3)
MAX_RETRIES=3

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================
# Enable research result caching (true/false, default: true)
ENABLE_CACHE=true

# Cache time-to-live in days (1-30, default: 7)
CACHE_TTL_DAYS=7

# Cache directory (default: ./.cache/research)
CACHE_DIR=./.cache/research

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Enable structured JSON logging (true/false, default: false)
STRUCTURED_LOGGING=false

# Log file path (optional, logs to file if set)
# LOG_FILE=./logs/research.log

# ============================================================================
# LANGSMITH TRACING (Optional - for debugging)
# ============================================================================
# Enable LangSmith tracing (true/false, default: false)
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_PROJECT=deep-research-agent
# LANGCHAIN_API_KEY=your_langsmith_api_key

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================
# LLM temperature for research (0.0-1.0, default: 0.7)
LLM_TEMPERATURE=0.7

# LLM temperature for synthesis (0.0-1.0, default: 0.3)
SYNTHESIS_TEMPERATURE=0.3

# Context window size for Ollama/LM Studio (1024-32768, default: 8192)
CONTEXT_WINDOW_SIZE=8192

# Enable content streaming for real-time updates (true/false, default: false)
ENABLE_STREAMING=false

# Maximum total tokens per LLM call (1000-100000, default: 4096)
MAX_TOKENS_PER_CALL=4096
